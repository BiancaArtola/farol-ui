{
  "name": "farol-ui",
  "version": "0.2.0",
  "description": "Accessible React components in blue, with light and dark mode.",
  "type": "module",
  "license": "MIT",
  "author": "Bianca Artola",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BiancaArtola/farol-ui.git"
  },
  "homepage": "https://github.com/BiancaArtola/farol-ui#readme",
  "bugs": {
    "url": "https://github.com/BiancaArtola/farol-ui/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "accessible",
    "a11y",
    "dark-mode",
    "design-system",
    "typescript"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/farol-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/farol-ui.js"
    },
    "./styles.css": "./dist/farol-ui.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "verificar": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run verificar",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
